# Hytale Server Mod Manager Environment Variables

# ============================================
# Mod Manager Settings
# ============================================

# Hytale Game ID on CurseForge (leave empty for auto-detection)
HYTALE_GAME_ID=

# CurseForge API Key (optional - uses default if not set)
# Get your key from: https://console.curseforge.com/
CURSEFORGE_API_KEY=

# Enable verbose logging
VERBOSE=false

# ============================================
# Server Control
# ============================================

# Start the Hytale server after mod updates
START_SERVER=true

# Run in standalone mod manager mode (no server)
STANDALONE_MODE=false

# ============================================
# File Permissions
# ============================================

# User and Group IDs for file ownership
PUID=1000
PGID=1000

# ============================================
# Hytale Server Settings
# ============================================

# Server display name
SERVER_NAME=hytale-modded-server

# Server port (UDP)
DEFAULT_PORT=5520

# Player settings
MAX_PLAYERS=20
VIEW_DISTANCE=12

# Authentication mode: authenticated or offline
AUTH_MODE=authenticated

# Backups
ENABLE_BACKUPS=false
BACKUP_FREQUENCY=30

# Performance
USE_AOT_CACHE=true
MIN_MEMORY=
MAX_MEMORY=8G
JVM_ARGS=

# Other
DISABLE_SENTRY=true
ACCEPT_EARLY_PLUGINS=false
DOWNLOAD_ON_START=true
